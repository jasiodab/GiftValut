generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id               String         @id @default(cuid())
  userId           String?
  name             String
  url              String
  normalizedUrl    String
  description      String?
  imagePath        String?
  imageSourceUrl   String?
  currentPrice     Float?
  originalPrice    Float?
  currency         String         @default("PLN")
  availability     String?
  status           String         @default("TO_CONSIDER")
  notes            String?
  autoTrack        Boolean        @default(true)
  storeId          String?
  categoryId       String
  lastCheckedAt    DateTime?
  lastCheckStatus  String         @default("NEVER")
  lastCheckError   String?
  lastPriceCheckAt DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  user          User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  store         Store?         @relation(fields: [storeId], references: [id], onDelete: SetNull)
  category      Category       @relation(fields: [categoryId], references: [id])
  priceHistory  PriceHistory[]
  priceChecks   PriceCheck[]
  priceOffers   PriceOffer[]
  tags          ProductTag[]

  @@index([status])
  @@index([categoryId])
  @@index([storeId])
  @@index([createdAt])
  @@index([autoTrack, lastCheckedAt])
  @@index([userId])
  @@unique([userId, url])
  @@unique([userId, normalizedUrl])
}

model Category {
  id        String    @id @default(cuid())
  userId    String?
  name      String
  slug      String
  color     String    @default("#D9A3B0")
  icon      String    @default("Tag")
  sortOrder Int       @default(0)
  isDefault Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  products  Product[]
  @@unique([userId, name])
  @@unique([userId, slug])
}

model Store {
  id        String    @id @default(cuid())
  userId    String?
  name      String
  domain    String
  createdAt DateTime  @default(now())
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  products  Product[]
  @@unique([userId, domain])
}

model PriceHistory {
  id            String   @id @default(cuid())
  userId        String?
  productId     String
  price         Float
  originalPrice Float?
  currency      String   @default("PLN")
  availability  String?
  source        String   @default("AUTOMATIC")
  recordedAt    DateTime @default(now())

  user    User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, recordedAt])
}

model Tag {
  id        String       @id @default(cuid())
  userId    String?
  name      String
  createdAt DateTime     @default(now())
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  products  ProductTag[]
  @@unique([userId, name])
}

model ProductTag {
  productId String
  tagId     String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId])
}

model Settings {
  id                         Int      @id @default(autoincrement())
  userId                     String?  @unique
  currency                   String   @default("PLN")
  autoTrackingEnabled        Boolean  @default(true)
  priceUpdateIntervalMinutes Int      @default(360)
  defaultProductView         String   @default("grid")
  lastBackupAt               DateTime?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
  user                       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PriceCheck {
  id            String             @id @default(cuid())
  userId        String?
  productId     String
  status        String             @default("RUNNING")
  startedAt     DateTime           @default(now())
  finishedAt    DateTime?
  errorMessage  String?

  user      User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  runs      PriceProviderRun[]
  snapshots PriceSnapshot[]

  @@index([productId, startedAt])
  @@index([status])
}

model PriceProviderRun {
  id           String     @id @default(cuid())
  checkId      String
  provider     String
  status       String     @default("RUNNING")
  resultsCount Int        @default(0)
  errorMessage String?
  finishedAt   DateTime?

  check PriceCheck @relation(fields: [checkId], references: [id], onDelete: Cascade)

  @@index([checkId])
  @@index([provider])
}

model PriceOffer {
  id                    String          @id @default(cuid())
  userId                String?
  productId             String
  provider              String
  externalId            String
  title                 String
  url                   String
  sellerName            String?
  imageUrl              String?
  brand                 String?
  model                 String?
  ean                   String?
  condition             String?
  latestTotalPriceCents Int?
  currency              String          @default("PLN")
  lastSeenAt            DateTime        @default(now())
  matchScore            Int             @default(0)
  matchStatus           String          @default("PENDING")
  confirmedAt           DateTime?
  rejectedAt            DateTime?

  user      User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  snapshots PriceSnapshot[]

  @@unique([userId, provider, externalId])
  @@index([productId])
  @@index([provider])
  @@index([matchStatus])
  @@index([latestTotalPriceCents])
}

model PriceSnapshot {
  id                 String    @id @default(cuid())
  offerId            String
  checkId            String?
  itemPriceCents     Int?
  shippingPriceCents Int?
  totalPriceCents    Int?
  currency           String    @default("PLN")
  availability       String?
  observedAt         DateTime  @default(now())

  offer PriceOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  check PriceCheck? @relation(fields: [checkId], references: [id], onDelete: SetNull)

  @@index([offerId, observedAt])
  @@index([checkId])
}

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  email        String    @unique
  passwordHash String
  role         String    @default("USER")
  status       String    @default("ACTIVE")
  mustChangePassword Boolean @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?

  sessions     Session[]
  invitationsCreated Invitation[] @relation("InvitationCreator")
  invitationUsed Invitation? @relation("InvitationUsedBy")
  products     Product[]
  stores       Store[]
  categories   Category[]
  tags         Tag[]
  priceChecks  PriceCheck[]
  priceOffers  PriceOffer[]
  priceHistory PriceHistory[]
  settings     Settings?
  uploads      Upload[]

  @@index([role])
  @@index([status])
}

model Upload {
  id        String   @id @default(cuid())
  filename  String
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([filename, userId])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  lastSeenAt DateTime @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Invitation {
  id          String   @id @default(cuid())
  tokenHash   String   @unique
  createdById String
  usedById    String?  @unique
  expiresAt   DateTime
  usedAt      DateTime?
  revokedAt   DateTime?
  createdAt   DateTime @default(now())

  createdBy User @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: Cascade)
  usedBy    User? @relation("InvitationUsedBy", fields: [usedById], references: [id], onDelete: SetNull)

  @@index([expiresAt])
}
